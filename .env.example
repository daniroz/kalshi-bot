# Copy this to .env and fill in your credentials
KALSHI_API_KEY=your_api_key_here
KALSHI_API_KEY_ID=your_key_id_here

# Risk settings
STARTING_BALANCE=500
MAX_POSITION_SIZE_PCT=0.05      # Max 5% of balance per trade
MAX_DAILY_LOSS_PCT=0.10         # Stop trading if down 10% in a day
MAX_OPEN_POSITIONS=10
MIN_EDGE_THRESHOLD=0.03         # Minimum 3 cent edge to enter a trade

# Strategy toggles (true/false)
STRATEGY_ARBITRAGE=true
STRATEGY_MARKET_MAKER=true
STRATEGY_MISPRICING=true

# Demo mode — set to false only when ready to trade real money
DEMO_MODE=true
