# Copy this to .env and fill in your credentials
KALSHI_API_KEY=your_api_key_here

# Risk settings
STARTING_BALANCE=500
MAX_POSITION_SIZE_PCT=0.05
MAX_POSITION_SCALE_PCT=0.12
MAX_DAILY_LOSS_PCT=1.0
MAX_OPEN_POSITIONS=999
MIN_EDGE_THRESHOLD=0.01

# Strategy toggles (true/false)
STRATEGY_ARBITRAGE=true
STRATEGY_MARKET_MAKER=true
STRATEGY_MISPRICING=true
STRATEGY_SMART_MONEY=true
STRATEGY_WEATHER=true
STRATEGY_ORDERBOOK=true
STRATEGY_MOMENTUM=true
STRATEGY_INTRADAY=true
STRATEGY_SPORTS=true
STRATEGY_CRYPTO=true
STRATEGY_NEWS=true
STRATEGY_CALENDAR=true

# Alerts — install ntfy app, subscribe to your topic, add it here
NTFY_TOPIC=

# FRED API key (free at fred.stlouisfed.org) — enables economic calendar data
FRED_API_KEY=

# Demo mode — set to false only when ready to trade real money
DEMO_MODE=true
